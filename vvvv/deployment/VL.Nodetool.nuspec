<?xml version="1.0"?>
<package xmlns="http://schemas.microsoft.com/packaging/2011/10/nuspec.xsd">
  <metadata>
    <id>VL.Nodetool</id>
    <version>$version$</version>
    <title>VL.Nodetool</title>
    <authors>Nodetool Contributors</authors>
    <projectUrl>https://github.com/nodetool-ai/nodetool-sdk</projectUrl>
    <repository type="git" url="https://github.com/nodetool-ai/nodetool-sdk.git" />
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <description>NodeTool integration for vvvv: run AI workflows and nodes from VL through the portable C# SDK.</description>
    <tags>VL AI workflow nodetool</tags>
    <license type="expression">AGPL-3.0-only</license>
    <readme>docs\README.md</readme>
    <icon>icon\nugeticon.png</icon>
    <dependencies>
      <group targetFramework="net8.0">
        <dependency id="VL.Core" version="2025.7.1" />
        <dependency id="MessagePack" version="3.1.8" />
        <dependency id="Microsoft.Extensions.Logging" version="8.0.1" />
        <dependency id="Microsoft.Extensions.DependencyInjection" version="8.0.1" />
        <dependency id="SkiaSharp" version="2.88.8" />
      </group>

    </dependencies>
  </metadata>
  <files>
    <!-- Help patches -->
    <file src="..\help\**" target="help\" />

    <!-- VL document -->
    <file src=".pack\VL.Nodetool.vl" target="" />
    <file src=".pack\VL.Nodetool.HDE.vl" target="" />

    <!-- Managed DLLs -->
    <file src="..\..\csharp\Nodetool.SDK.VL\bin\Release\net8.0\Nodetool.SDK.VL.dll" target="lib\net8.0\" />
    <file src="..\..\csharp\Nodetool.SDK.VL.HDE\bin\Release\net8.0\Nodetool.SDK.VL.HDE.dll" target="lib\net8.0\" />
    <file src="..\..\csharp\Nodetool.SDK.VL\bin\Release\net8.0\Nodetool.SDK.dll" target="lib\net8.0\" />
    <file src="..\..\csharp\Nodetool.SDK.VL\bin\Release\net8.0\Nodetool.Types.dll" target="lib\net8.0\" />

    <!-- Package icon (uncomment when icon is available) -->
    <file src="nugeticon.png" target="icon\" />

    <!-- README -->
    <file src="..\README.md" target="docs\" />
  </files>
</package>
