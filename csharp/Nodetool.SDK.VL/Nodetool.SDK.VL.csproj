<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- This project builds the managed adapter assembly. VL.Nodetool is the
         sole distributable vvvv package and is produced by deployment/nuspec. -->
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IsPackable>false</IsPackable>
    <PackageId>Nodetool.SDK.VL</PackageId>
    <Description>VL/vvvv integration for Nodetool SDK - workflow execution and node management</Description>
    <Authors>Nodetool Contributors</Authors>
    <RepositoryUrl>https://github.com/nodetool-ai/nodetool</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="VL.Core" Version="2025.7.1" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="SkiaSharp" Version="2.88.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nodetool.SDK\Nodetool.SDK.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Nodetool.Types\Nodetool.Types.csproj" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="VL.Core" />
    <Using Include="VL.Core.CompilerServices" />
    <Using Include="VL.Core.Import" />
  </ItemGroup>

  <PropertyGroup>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);IncludeProjectReferenceDlls</TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>

  <Target Name="IncludeProjectReferenceDlls">
    <ItemGroup>
      <BuildOutputInPackage Include="$(OutputPath)Nodetool.SDK.dll" />
      <BuildOutputInPackage Include="$(OutputPath)Nodetool.Types.dll" />
    </ItemGroup>
  </Target>

</Project>
